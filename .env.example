# Copy to .env and adjust. Every setting can also be given as a real environment variable.

# Title shown in the header and page titles
SITE_TITLE=SHMARQL

# Server bind address (used by `uv run shmarql`)
HOST=127.0.0.1
PORT=8000

# Public base URL of this application, e.g. https://kg.example.org/ (used to resolve entity
# IRIs and serve content negotiation for them); optional.
SITE_URI=

# Verbose logging
DEBUG=0

# YAML file with the backend SPARQL triplestores ("profiles")
PROFILES_PATH=profiles.yaml

# Endpoint address of the profile served at /sparql (e.g. https://query.wikidata.org/sparql).
# Overrides the `default:` entry in the YAML file when set; the endpoint then becomes
# the default used for queries. When no profiles are configured, it adds a single new
# profile for that backend, so queries keep working.
ENDPOINT=

# Timeout (seconds) and User-Agent for upstream SPARQL requests
SPARQL_TIMEOUT=30
SPARQL_USER_AGENT=shmarql/0.1 (+https://github.com/epoz/shmarql)

# Comma separated origins allowed to call the endpoints from other sites ("*" for all)
CORS_ORIGINS=

# Redis instance used to cache SPARQL query results (e.g. the entity viewer's CONSTRUCT
# and inverse/label lookups); when empty, no caching backend is used
REDIS_HOST=
# Time to live of cached query results, in seconds
CACHE_TTL=300

# Directory with the Markdown documentation rendered off the root URL
DOCS_PATH=docs

# Optional: YAML overriding the bundled LODEON renderer configuration (e.g. embed allowedOrigins)
LODEON_CONFIG_PATH=
# Optional: directory replacing the bundled LODEON browser assets
LODEON_ASSETS_PATH=

# LODEON story editor at /lodeon/
LODEON_EDITOR_ENABLED=1
# Secret key for signing editor access tokens (JWTs, HS256).
SECRET_KEY=shmarql-dev-secret
# Lifetime of an editor access token, in days.
ACCESS_TOKEN_EXPIRE_DAYS=30
# SQLite database with the editor users (username, name, bcrypt password, activation date).
# Editors log in with a username/password via POST /token to enable Preview and Publish.
# When the database holds editor users, the site login is enabled and all pages redirect
# to /login for visitors who are not logged in (public docs pages with "access: public"
# front matter stay readable).
USERS_DB_PATH=editor_users.sqlite
# Published stories go to DOCS_PATH/<LODEON_STORY_DIR>/<slug>/
LODEON_STORY_DIR=story
# Where previews are kept (default: a folder in the system temp dir) and for how long (seconds)
LODEON_PREVIEW_PATH=
LODEON_PREVIEW_TTL=3600
# Maximum size of a Preview/Publish upload, in MB
LODEON_MAX_UPLOAD_MB=100

# UI / label language negotiation
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,nl
