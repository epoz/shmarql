# Copy to .env and adjust. Every setting can also be given as a real environment variable.

# Title shown in the header and page titles
SITE_TITLE=SHMARQL

# Server bind address (used by `uv run shmarql`)
HOST=127.0.0.1
PORT=8000

# Verbose logging
DEBUG=0

# YAML file with the backend SPARQL triplestores ("profiles")
PROFILES_PATH=profiles.yaml

# Profile (name or hash key) served at /sparql. Overrides `default:` in the YAML file.
DEFAULT_PROFILE=

# Timeout (seconds) and User-Agent for upstream SPARQL requests
SPARQL_TIMEOUT=30
SPARQL_USER_AGENT=shmarql/0.1 (+https://github.com/epoz/shmarql)

# Comma separated origins allowed to call the endpoints from other sites ("*" for all)
CORS_ORIGINS=

# Directory with the Markdown documentation rendered off the root URL
DOCS_PATH=docs

# Optional: YAML overriding the bundled LODEON renderer configuration (e.g. embed allowedOrigins)
LODEON_CONFIG_PATH=
# Optional: directory replacing the bundled LODEON browser assets
LODEON_ASSETS_PATH=

# LODEON story editor at /lodeon/
LODEON_EDITOR_ENABLED=1
# Access token for the editor. When set, Preview and Publish need a login with it.
# When empty, Preview is open to everyone and Publish is disabled.
LODEON_EDITOR_TOKEN=
# Published stories go to DOCS_PATH/<LODEON_STORY_DIR>/<slug>/
LODEON_STORY_DIR=story
# Where previews are kept (default: a folder in the system temp dir) and for how long (seconds)
LODEON_PREVIEW_PATH=
LODEON_PREVIEW_TTL=3600
# Maximum size of a Preview/Publish upload, in MB
LODEON_MAX_UPLOAD_MB=100

# UI / label language negotiation
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,nl
