{
  "name": "lodeon",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:shmarql-verovio": "vite build --config vite.verovio.config.ts",
    "preview": "vite preview",
    "lint": "eslint src *.config.ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.{html,js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"*.{html,js,json,ts}\"",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit:dependencies": "npm audit --audit-level=low"
  },
  "dependencies": {
